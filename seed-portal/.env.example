# Copy to .env for local use. Never commit .env or the data directory.
NODE_ENV=development
PORT=3100
DATA_DIR=./data
SEED_ORIGIN=http://localhost:3100
ADMIN_ORIGIN=http://localhost:3100
TRUST_PROXY=0

# Generate with: node scripts/generate-admin-hash.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Generate a random secret; keep it stable across restarts.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

CODE_DAYS=10
SESSION_DAYS=90
RETENTION_DAYS=365

# disabled never delivers mail and never returns a code to the browser.
# Choose resend or smtp and configure a verified sender to enable email login.
MAIL_PROVIDER=smtp
MAIL_FROM=Superfast Robotics <hello@superfastrobotics.com>
RESEND_API_KEY=

# Google Workspace: full mailbox address as SMTP_USER and MAIL_FROM.
# SMTP_PASS is an app password, not the ordinary Google account password.
# Port 587 uses required STARTTLS even though SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@superfastrobotics.com
SMTP_PASS=

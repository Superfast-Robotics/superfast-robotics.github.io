{
  "name": "superfast-seed-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "start:production": "node src/server.js",
    "test": "node --test test/mail.test.js test/portal.test.js",
    "import:deck": "node --env-file=.env scripts/import-deck.js",
    "check": "node scripts/check.js",
    "mail:verify": "node --env-file=.env scripts/verify-mail.js",
    "cf:build": "node scripts/cloudflare-build.js",
    "cf:dev": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:test": "node --test cloudflare/mail.test.js cloudflare/tests/portal.workerd.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "miniflare": "^5.20261116.0-beta",
    "supertest": "^7.1.4",
    "wrangler": "^4.163.0"
  }
}

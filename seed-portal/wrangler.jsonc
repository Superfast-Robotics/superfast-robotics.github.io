{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superfast-seed-portal",
  "account_id": "8df378989a27166c1180b588582573df",
  "main": "cloudflare/entry.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "superfast-seed-portal",
    "database_id": "00000000-0000-0000-0000-000000000000"
  }],
  "r2_buckets": [{ "binding": "DECKS", "bucket_name": "superfast-seed-decks" }],
  "durable_objects": { "bindings": [{ "name": "PORTAL_API", "class_name": "PortalApi" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PortalApi"] }],
  "triggers": { "crons": ["23 4 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "ENVIRONMENT": "production",
    "SEED_ORIGIN": "https://seed.superfastrobotics.com",
    "ADMIN_ORIGIN": "https://superadmin.superfastrobotics.com",
    "ADMIN_USERNAME": "admin",
    "CODE_DAYS": "10",
    "SESSION_DAYS": "90",
    "RETENTION_DAYS": "365",
    "MAIL_PROVIDER": "smtp",
    "MAIL_FROM": "Superfast Robotics <hello@superfastrobotics.com>",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "hello@superfastrobotics.com"
  }
}
